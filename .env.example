# docker-compose.yml shu faylni ./.env dan avtomatik o'qiydi.
# Nusxa oling: cp .env.example .env

DB_DATABASE=rizqimbot
DB_USERNAME=rizqimbot
DB_PASSWORD=secret

# Redis (kesh, navbat, sessiya, rate-limit): compose'dagi `redis` xizmati. REDIS_HOST=redis va REDIS_PORT=6379 ni
# docker-compose.yml o'zi beradi (backend/.env dagi 127.0.0.1 ni bekor qiladi), shuning uchun bu yerda faqat parol.
# Bo'sh bo'lsa Redis parolsiz ishlaydi (tashqi portga ochilmagan, faqat compose tarmog'ida). To'ldirilsa Redis ham,
# backend/queue/scheduler ham shu parolni ishlatadi (backend/.env dagi REDIS_PASSWORD o'rniga). Parolda $ bo'lmasin.
REDIS_PASSWORD=

# Real-time buyurtma holatlari (Laravel Reverb, compose'dagi `reverb` xizmati). Shu uchta kalit backend, queue, reverb
# va Mini App build'i (VITE_REVERB_APP_KEY) uchun yagona manba: backend/.env dagi REVERB_APP_* Docker'da ishlatilmaydi.
# Bir marta yarating: REVERB_APP_ID=$(openssl rand -hex 4), REVERB_APP_KEY=$(openssl rand -hex 16),
# REVERB_APP_SECRET=$(openssl rand -hex 32). KEY'ni o'zgartirgandan keyin: docker compose up -d --build (frontend ham).
# Kalitlar to'ldirilgach BROADCAST_CONNECTION=reverb qiling. null (yoki log) real-time'ni o'chiradi; Mini App so'rov
# bilan yangilanishda davom etadi. reverb + bo'sh kalit xavfli (private kanal imzosini istalgan kishi soxtalashtiradi):
# app:check-production bunda konteynerni ishga tushirmaydi.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# WebSocket ochishga ruxsat etilgan hostlar (Origin), vergul bilan; * = hammasi (app:check-production ogohlantiradi).
# Yozing: Mini App hosti, hamkor paneli hosti (panel.<domen>: panel doskasi real-time'i) va API hosti (oshxona ekrani —
# KDS ilovasi Origin sifatida RIZQIM_API_URL hostini yuboradi; odatda Mini App hosti bilan bir xil, alohida bo'lsa uni
# ham qo'shing). Ro'yxatda bo'lmagan host rad etiladi (4009) va o'sha ekran jim, faqat polling bilan ishlaydi.
# Masalan: example.uz,panel.example.uz (API boshqa xostda bo'lsa: ...,api.example.uz). docs/DEPLOY.md, 9-bo'lim
REVERB_ALLOWED_ORIGINS=*

BACKEND_PORT=8000
FRONTEND_PORT=8080

# Hamkor veb-panel (compose'dagi `partner-web`, partner/web). Tashqi proksi panel.<domen> ni PARTNER_WEB_PORT ga beradi.
# PARTNER_PUBLIC_API_BASE_URL: brauzer API'ga shu manzil orqali murojaat qiladi ("/api" bilan tugaydi; odatda Mini App
# domenidagi /api, uni frontend backend'ga uzatadi). Bo'sh qolsa panel ishlamaydi (ichki http://backend/api brauzerga
# ko'rinmaydi). Panel origin'i backend/.env dagi CORS_ALLOWED_ORIGINS da bo'lishi shart. docs/DEPLOY.md, 4-bo'lim
PARTNER_WEB_PORT=3000
# Port qaysi manzilda ochiladi: standart 127.0.0.1 (faqat shu xostdagi tashqi proksi). Panel mijoz IP'sini proksi yozgan
# X-Forwarded-For dan oladi, shuning uchun port proksini chetlab internetga ochilmasin. docs/DEPLOY.md, 4-bo'lim
# PARTNER_WEB_BIND=127.0.0.1
PARTNER_PUBLIC_API_BASE_URL=https://example.uz/api
# Sessiya cookie'larida Secure (faqat HTTPS). false faqat http:// orqali sinab ko'rishda
PARTNER_SESSION_COOKIE_SECURE=true
# Panel doskasi uchun real-time yuqoridagi REVERB_APP_KEY bilan ishlaydi; host bo'sh = PARTNER_PUBLIC_API_BASE_URL host'i
# PARTNER_REVERB_HOST=
# PARTNER_REVERB_PORT=443
# PARTNER_REVERB_SCHEME=https
# Hududlar xaritasi: production'da hisobli plitka provayderi (bo'sh = ochiq OSM, faqat sinov uchun)
# PARTNER_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# PARTNER_MAP_ATTRIBUTION= — HTML sifatida chiqadi (havola bo'lishi mumkin): faqat o'zingiz yozgan, ishonchli matn

VITE_BOT_USERNAME=rizqimbot
VITE_API_URL=/api/v1
# Mini App xodim ekranlaridagi "Web panelda tahrirlash" havolasi: hamkor paneli manzili, masalan https://panel.example.uz
# (build vaqtida; o'zgartirgandan keyin docker compose up -d --build frontend). Bo'sh = havolasiz, faqat matn
# RIZQIM boshqaruv markazi (compose'dagi `platform-admin`, platform/admin): admin.<domen> ni ADMIN_WEB_PORT ga bering.
# Brauzer backend'ga ilovaning o'z manzili orqali murojaat qiladi: CORS va API manzili kerak emas. Port standart bo'yicha
# faqat 127.0.0.1 da (partner-web kabi, IP limitlari uchun). docs/DEPLOY.md, 4-bo'lim, «RIZQIM boshqaruv markazi»
ADMIN_WEB_PORT=3100
# ADMIN_WEB_BIND=127.0.0.1
# Sessiya cookie'sida Secure (faqat HTTPS). false faqat http:// orqali sinab ko'rishda
ADMIN_SESSION_COOKIE_SECURE=true
VITE_PARTNER_WEB_URL=

# Mini App xaritasi (build vaqtida o'rnatiladi, o'zgartirgandan keyin: docker compose up -d --build frontend).
# Bo'sh qoldirilsa OpenStreetMap'ning ochiq tile serveri ishlatiladi: u FAQAT ishlab chiqish va kam trafik uchun
# (OSM tile usage policy). Productionda akkauntingiz bor provayder yoki o'z tile serveringizni bering, masalan
# https://tiles.example.com/{z}/{x}/{y}.png, va o'sha provayder talab qiladigan attribution (HTML) ni. Attribution
# xaritada HTML sifatida chiqadi (escape qilinmaydi): bu yerga faqat o'zingiz yozgan, ishonchli matn qo'ying.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Mini App'ning Reverb ulanishi (build vaqtida; o'zgartirgandan keyin docker compose up -d --build frontend).
# VITE_REVERB_APP_KEY bo'sh bo'lsa REVERB_APP_KEY olinadi. Host bo'sh = Mini App domeni: WebSocket shu origin'dagi
# /app/ orqali (customer/miniapp/docker/nginx.conf -> reverb:8080). Port/scheme brauzer ko'radigan tashqi HTTPS (443/https).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Mini App Sentry (build vaqtida o'rnatiladi: docker compose up -d --build frontend). VITE_SENTRY_DSN bo'sh bo'lsa
# Sentry yuklanmaydi ham, hech narsa yuborilmaydi. Backend uchun SENTRY_LARAVEL_DSN backend/.env da. docs/OPERATIONS.md
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# Deploy versiyasi (masalan git sha); backend'dagi SENTRY_RELEASE bilan bir xil bo'lsin
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Zaxira nusxa (docker compose'dagi `backup` xizmati, scripts/backup.sh): har kuni BACKUP_TIME (UTC) da pg_dump.
# Fayllar BACKUP_HOST_DIR papkasiga tushadi (serverda; serverdan tashqariga ham nusxalang: BACKUP_S3_* quyida).
BACKUP_HOST_DIR=./backups
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14
# Server tashqarisiga nusxa, S3-mos xotiraga (AWS S3, Cloudflare R2, Backblaze B2, MinIO): to'rt qiymat (endpoint, bucket,
# kalit, maxfiy kalit) to'ldirilsa har bir muvaffaqiyatli dump (va .sha256) rclone bilan yuklanadi (`backup` obrazida bor).
# Hammasi bo'sh = o'chiq. Bucket oldindan yaratilgan bo'lsin; eski nusxalarni bucket lifecycle qoidasi bilan o'chiring
# (docs/OPERATIONS.md, 4-bo'lim). Kalitga o'chirish huquqini bermang. Parolda $ bo'lmasin.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=
# Ixtiyoriy: region (masalan auto, eu-central-1), bucket ichidagi papka (rizqim/production) va, lifecycle o'rniga,
# S3 dagi shu kundan eskilarini o'chirish (kalitda o'chirish huquqi kerak)
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=
BACKUP_S3_RETENTION_DAYS=
# Ixtiyoriy: har bir zaxiradan keyin bajariladigan buyruq, fayl yo'li $BACKUP_FILE da. Bitta qo'shtirnoq SHART (aks holda
# compose $BACKUP_FILE ni o'zi almashtirib yuboradi). S3 o'rniga o'zingizning vositangiz kerak bo'lsa (rclone `backup` obrazida bor):
#   BACKUP_OFFSITE_CMD='rclone copy "$BACKUP_FILE" remote:rizqim-backups'
BACKUP_OFFSITE_CMD=

# Production uchun majburiy qiymatlar. Backend konteyneri ularni backend/.env dan (env_file) o'qiydi,
# entrypoint esa boshqacha bo'lsa ishga tushmaydi. Lokal ishlab chiqishda: APP_ENV=local, APP_DEBUG=true
APP_ENV=production
APP_DEBUG=false
TELEGRAM_ALLOW_MOCK_AUTH=false
SMS_EXPOSE_CODE_IN_RESPONSE=false

# Kesh, navbat va sessiya Redis'da (production standarti); backend konteyneri ularni ham backend/.env dan o'qiydi
# (bu yerda eslatma sifatida). 'database' drayveri zaxira variant bo'lib qoladi: Redis'siz ishlash uchun uchalasini
# ham database qiling. Database-navbatdan o'tishdan oldin uni bo'shating: php artisan queue:work database --stop-when-empty
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis

# Faqat SuperAdminSeeder uchun (backend/.env): productionda majburiy, parol kamida 12 belgi
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
