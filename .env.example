# docker-compose.yml shu faylni ./.env dan avtomatik o'qiydi.
# Nusxa oling: cp .env.example .env

DB_DATABASE=rizqimbot
DB_USERNAME=rizqimbot
DB_PASSWORD=secret

# Redis (kesh, navbat, sessiya, rate-limit): compose'dagi `redis` xizmati. REDIS_HOST=redis va REDIS_PORT=6379 ni
# docker-compose.yml o'zi beradi (backend/.env dagi 127.0.0.1 ni bekor qiladi), shuning uchun bu yerda faqat parol.
# Bo'sh bo'lsa Redis parolsiz ishlaydi (tashqi portga ochilmagan, faqat compose tarmog'ida). To'ldirilsa Redis ham,
# backend/queue/scheduler ham shu parolni ishlatadi (backend/.env dagi REDIS_PASSWORD o'rniga). Parolda $ bo'lmasin.
REDIS_PASSWORD=

BACKEND_PORT=8000
FRONTEND_PORT=8080

VITE_BOT_USERNAME=rizqimbot
VITE_API_URL=/api/v1

# Mini App xaritasi (build vaqtida o'rnatiladi, o'zgartirgandan keyin: docker compose up -d --build frontend).
# Bo'sh qoldirilsa OpenStreetMap'ning ochiq tile serveri ishlatiladi: u FAQAT ishlab chiqish va kam trafik uchun
# (OSM tile usage policy). Productionda akkauntingiz bor provayder yoki o'z tile serveringizni bering, masalan
# https://tiles.example.com/{z}/{x}/{y}.png, va o'sha provayder talab qiladigan attribution (HTML) ni.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Production uchun majburiy qiymatlar. Backend konteyneri ularni backend/.env dan (env_file) o'qiydi,
# entrypoint esa boshqacha bo'lsa ishga tushmaydi. Lokal ishlab chiqishda: APP_ENV=local, APP_DEBUG=true
APP_ENV=production
APP_DEBUG=false
TELEGRAM_ALLOW_MOCK_AUTH=false
SMS_EXPOSE_CODE_IN_RESPONSE=false

# Kesh, navbat va sessiya Redis'da (production standarti); backend konteyneri ularni ham backend/.env dan o'qiydi
# (bu yerda eslatma sifatida). 'database' drayveri zaxira variant bo'lib qoladi: Redis'siz ishlash uchun uchalasini
# ham database qiling. Database-navbatdan o'tishdan oldin uni bo'shating: php artisan queue:work database --stop-when-empty
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis

# Faqat SuperAdminSeeder uchun (backend/.env): productionda majburiy, parol kamida 12 belgi
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
