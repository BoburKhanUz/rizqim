# Archived/old files (zips, sql dumps, tunnel logs) - never commit
/_archive/

# Env files
.env
.env.backup
.env.production
*/.env
*/.env.backup

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitkeep
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/storage/pail/
backend/bootstrap/cache/*.php
backend/database/database.sqlite
backend/.phpunit.result.cache
backend/auth.json

# Frontend (Vite/React)
customer/miniapp/node_modules/
customer/miniapp/dist/
customer/miniapp/dist-ssr/
customer/miniapp/*.local

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
Thumbs.db

# PostgreSQL zaxiralari (scripts/backup.sh, docker-compose.yml `backup` xizmati): mijoz ma'lumotlari, hech qachon commit qilinmasin
/backups/

# Dart / Flutter (P1-26): pubspec.lock of the workspace root IS committed
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pos/apps/*/build/
packages/dart/*/build/
**/.pub-cache/
