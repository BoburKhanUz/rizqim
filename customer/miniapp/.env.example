# Lokal ishlab chiqish (npm run dev): cp .env.example .env
# Docker'da bu qiymatlarni ildizdagi .env beradi (docker-compose.yml build argumentlari), shu fayl o'qilmaydi.

VITE_BOT_USERNAME=rizqimbot
VITE_API_URL=/api/v1

# Sentry: VITE_SENTRY_DSN bo'sh bo'lsa SDK yuklanmaydi ham, hech narsa yuborilmaydi.
# Token, initData va telefon raqamlar yuborishdan oldin tozalanadi (src/lib/sentry.ts).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# Performance trace'lar ulushi: 0 = o'chiq, 0.05 = 5%
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Real-time buyurtma holatlari (Laravel Reverb). VITE_REVERB_APP_KEY = backend'dagi REVERB_APP_KEY; bo'sh bo'lsa real-time
# o'chiq va ekranlar so'rov bilan yangilanadi. Host bo'sh = sahifa ochilgan domen. Lokal: php artisan reverb:start
# (backend .env: REVERB_SERVER_HOST=127.0.0.1, REVERB_SERVER_PORT=8080) va shu yerda VITE_REVERB_PORT=8080,
# VITE_REVERB_SCHEME=http. Kanal obunasi POST /api/broadcasting/auth (Bearer token) orqali.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
