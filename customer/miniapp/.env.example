# Lokal ishlab chiqish (npm run dev): cp .env.example .env
# Docker'da bu qiymatlarni ildizdagi .env beradi (docker-compose.yml build argumentlari), shu fayl o'qilmaydi.

VITE_BOT_USERNAME=rizqimbot
VITE_API_URL=/api/v1

# Sentry: VITE_SENTRY_DSN bo'sh bo'lsa SDK yuklanmaydi ham, hech narsa yuborilmaydi.
# Token, initData va telefon raqamlar yuborishdan oldin tozalanadi (src/lib/sentry.ts).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# Performance trace'lar ulushi: 0 = o'chiq, 0.05 = 5%
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Real-time buyurtma holatlari (Laravel Reverb). VITE_REVERB_APP_KEY = backend'dagi REVERB_APP_KEY; bo'sh bo'lsa real-time
# o'chiq va ekranlar so'rov bilan yangilanadi. Host bo'sh = sahifa ochilgan domen. Lokal: php artisan reverb:start
# (backend .env: REVERB_SERVER_HOST=127.0.0.1, REVERB_SERVER_PORT=8080) va shu yerda VITE_REVERB_PORT=8080,
# VITE_REVERB_SCHEME=http. Kanal obunasi POST /api/broadcasting/auth (Bearer token) orqali.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Hamkor web panel manzili (masalan https://panel.rizqim.uz): taom sahifasidagi "Web panelda tahrirlash" havolasi shunga olib boradi.
# Bo'sh bo'lsa shu matn havolasiz ko'rsatiladi.
VITE_PARTNER_WEB_URL=

# Ochiq sayt (infra/landing): birinchi ochilishdagi rozilik qatori va profildagi "Hujjatlar" shu saytning /shartlar va
# /maxfiylik sahifalariga olib boradi. Bo'sh bo'lsa https://rizqim.uz
VITE_SITE_URL=https://rizqim.uz

# Foydalanish statistikasi o'z serverimizga (POST /api/v1/analytics/events, README "Analitika"). Standart o'chiq. Bu
# BUILD vaqtidagi qiymat (Vite uni kodga yozib qo'yadi): bu yerda faqat lokal build/dev uchun. Serverdagi Mini App
# obrazida u repozitoriy Variable PROD_VITE_ANALYTICS_ENABLED (staging: STAGING_VITE_ANALYTICS_ENABLED) = true va qayta
# deploy bilan yoqiladi (.github/workflows/deploy.yml); faqat maxfiylik siyosatining yangi matni e'lon qilingandan keyin.
# Ishlayotgan o'chirgich — serverdagi ANALYTICS_ENABLED (backend .env): o'chiq bo'lsa hech narsa saqlanmaydi.
# app_version sifatida VITE_SENTRY_RELEASE yuboriladi (versiya yoki 7-12 belgili commit hash bo'lsa).
VITE_ANALYTICS_ENABLED=
