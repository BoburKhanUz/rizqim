# Hamkor veb-panel (partner/web). Docker'da qiymatlar konteyner muhitiga beriladi; mahalliy ishlashda shu fayl nusxasi
# `.env.local` ga yoziladi (git e'tiborsiz qoldiradi). Hammasi RUNTIME'da o'qiladi: image qayta yig'ilmaydi.

# Next serveri backend'ga shu manzil bilan murojaat qiladi (kirish: /api/session/* route handler'lari).
# Docker tarmog'ida: http://nginx/api yoki http://backend:8000/api. "/api" bilan tugaydi, oxirida "/" yo'q.
API_BASE_URL=http://127.0.0.1:8000/api

# Brauzer API'ga shu manzil bilan murojaat qiladi (to'g'ridan-to'g'ri, access token bilan). Brauzerdan ko'rinadigan
# manzil bo'lishi kerak. DIQQAT: bu boshqa origin bo'lgani uchun backend'da CORS_ALLOWED_ORIGINS ga panel origin'i
# (masalan https://panel.rizqim.uz yoki mahalliy http://localhost:3000) qo'shilishi shart. Bo'sh qoldirilsa API_BASE_URL ishlatiladi.
PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Cookie'larga `Secure` belgisini qo'yish. Production'da (NODE_ENV=production) standart `true`; faqat HTTP orqali
# sinab ko'rishda (masalan docker'dagi http://localhost:3000) `false` qiling.
SESSION_COOKIE_SECURE=

# Real-time (Laravel Reverb, docs/API.md §8): buyurtmalar doskasi yangi buyurtmani darhol ko'radi. Bo'sh REVERB_APP_KEY —
# real-time o'chiq, doska har 15 soniyada so'rov bilan yangilanadi. Backend'dagi REVERB_APP_KEY bilan bir xil. Host
# bo'sh bo'lsa PUBLIC_API_BASE_URL host'i. Obuna PUBLIC_API_BASE_URL/broadcasting/auth orqali (access token bilan) imzolanadi.
REVERB_APP_KEY=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

# Hududlar xaritasi plitkalari (runtime'da o'qiladi). Bo'sh = ochiq OpenStreetMap serveri: faqat ishlab chiqish va kam
# trafik uchun (uning foydalanish qoidasi), production'da hisobli provayder manzilini yozing.
# MAP_ATTRIBUTION xaritada HTML sifatida chiqadi (Leaflet, escape qilinmaydi; havola yozish mumkin): faqat
# administrator yozgan, ishonchli matn bo'lsin.
MAP_TILE_URL=
MAP_ATTRIBUTION=
