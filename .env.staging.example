# STAGING uchun ildiz .env namunasi (alohida serverda): cp .env.staging.example .env
# Production namunasi: .env.example. Staging production bilan bir xil stek, faqat docker-compose.staging.yml qo'shiladi.
# docs/DEPLOY.md, 10-bo'lim.

# Shu qator tufayli `docker compose ...` hamma fayllar bilan ishlaydi (-f yozish shart emas).
# Staging SERVERDA: asosiy + staging + edge (80/443, avtomatik TLS) + images (GHCR'dan tayyor obrazlar; GitHub Actions deploy.yml
# va infra/deploy/deploy.sh ishlatadi). Serverda yig'ish (build) kerak bo'lsa oxirgi faylni olib tashlang; lokal sinovda
# faqat birinchi ikkitasi qoladi. docs/DEPLOY.md, 10 va 11-bo'limlar.
COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml:docker-compose.edge.yml:docker-compose.images.yml

# --- Domenlar va edge (docker-compose.edge.yml, infra/edge/Caddyfile) ---
# Staging domeni stg.rizqim.uz. DNS: A yozuvlari `stg.rizqim.uz` va `*.stg.rizqim.uz` (yoki yetti host alohida) -> staging server IP'si.
# Hosts: stg.rizqim.uz (landing), app. (Mini App), api. (backend + WebSocket), business. (hamkor paneli), admin. (boshqaruv markazi),
# pos. (POS yuklab olish), links.; hammasi `.stg.rizqim.uz` ostida.
EDGE_DOMAIN=stg.rizqim.uz
EDGE_PROFILE=staging
# Let's Encrypt ogohlantirishlari uchun e-pochta (sertifikat muddati haqida)
EDGE_ACME_EMAIL=
# admin.stg.rizqim.uz ni IP bilan cheklash (ixtiyoriy): docs/SERVER_SETUP.md. Bo'sh = cheklovsiz
# EDGE_ADMIN_ACCESS=/etc/caddy/conf.d/admin-allow.caddy

# --- Avtomatik deploy (infra/deploy/deploy.sh yozadi/yangilaydi: IMAGE_PREFIX, IMAGE_TAG, IMAGE_TAG_*; qo'lda tegmang) ---
# Mini App obrazi muhit bo'yicha alohida yig'iladi: shu serverda staging
DEPLOY_TARGET=staging
# Deploy tugagach ommaviy manzilni ham tekshirish: warn (standart, faqat ogohlantiradi) yoki required (xato bo'lsa orqaga qaytaradi)
# DEPLOY_PUBLIC_CHECK=warn

# Baza: production nomi/paroli bilan bir xil bo'lmasin (boshqa serverda ham bo'lsa, tasodifan ulanib qolmaslik uchun)
DB_DATABASE=rizqim_staging
DB_USERNAME=rizqim_staging
DB_PASSWORD=CHANGE_ME_staging_db_password
REDIS_PASSWORD=
# Redis xotira chegarasi (noeviction): yetganda yozuv rad etiladi; used_memory chegaraning 80 foizidan oshsa ogohlantiring.
REDIS_MAXMEMORY=200mb

# Real-time (Reverb): staging'ning O'Z kalitlari (productionnikini ishlatmang). Bo'sh qolsa backend o'zi yaratadi va
# saqlaydi (M2, docs/DEPLOY.md 9-bo'lim). Qo'lda yaratish:
#   REVERB_APP_ID=$(openssl rand -hex 4)  REVERB_APP_KEY=$(openssl rand -hex 16)  REVERB_APP_SECRET=$(openssl rand -hex 32)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Origin'lar, vergul bilan, scheme'siz: Mini App hosti, hamkor paneli hosti (doska real-time'i) va API hosti (KDS ilovasi
# backend manzilining hostini yuboradi). app:check-production * da ogohlantiradi
REVERB_ALLOWED_ORIGINS=app.stg.rizqim.uz,business.stg.rizqim.uz,api.stg.rizqim.uz

# Bir xostda production bilan birga ishlatilsa portlar to'qnashmasin (alohida serverda 8000/8080 qoldirsa ham bo'ladi).
# Hammasi 127.0.0.1 da (deploy tekshiruvi shu portlardan); tashqaridan faqat edge (80/443)
BACKEND_PORT=8100
# Standart 127.0.0.1 (tashqi proksi shu xostda); boshqa xostdan bo'lsa BACKEND_BIND va firewall
# BACKEND_BIND=127.0.0.1
FRONTEND_PORT=8180
# POS ilovalarini yuklab olish sahifasi (pos-site): edge pos.stg.rizqim.uz ni compose tarmog'ida pos-site:80 ga beradi;
# port faqat xost ichida (127.0.0.1), tekshirish uchun. Ilova fayllari: POS_FILES_DIR (standart ./pos-files)
POS_SITE_PORT=8190
# rizqim.uz landing (landing): edge stg.rizqim.uz ni landing:8080 ga beradi; port faqat tekshirish uchun (127.0.0.1)
LANDING_PORT=8191
# Hamkor veb-panel (partner-web): edge business.stg.rizqim.uz ni partner-web:3000 ga beradi. Brauzer API'ga api.stg.rizqim.uz
# orqali murojaat qiladi ("/api" bilan tugaydi), shuning uchun panel origin'i (https://business.stg.rizqim.uz) backend/.env
# dagi CORS_ALLOWED_ORIGINS da bo'lsin. Real-time: PARTNER_REVERB_HOST bo'sh = API hosti (wss://api.stg.rizqim.uz/app/...)
PARTNER_WEB_PORT=8130
PARTNER_PUBLIC_API_BASE_URL=https://api.stg.rizqim.uz/api
PARTNER_SESSION_COOKIE_SECURE=true
# Panel doskasining real-time'i REVERB_APP_KEY bilan; host bo'sh = staging API host'i. Xarita: bo'sh = ochiq OSM
# PARTNER_REVERB_HOST=
# PARTNER_MAP_TILE_URL=

# RIZQIM boshqaruv markazi (platform-admin): edge admin.stg.rizqim.uz ni platform-admin:3000 ga beradi (CORS va API manzili kerak emas)
ADMIN_WEB_PORT=8140
ADMIN_SESSION_COOKIE_SECURE=true

# Mini App build argumentlari (staging TEST boti!). O'zgartirgandan keyin: docker compose up -d --build frontend
# DIQQAT: avtomatik deploy'da (docker-compose.images.yml) Mini App obrazi GitHub Actions'da yig'iladi: VITE_* qiymatlari bu fayldan EMAS,
# repozitoriy Variables'idan olinadi (STAGING_VITE_BOT_USERNAME, STAGING_VITE_PARTNER_WEB_URL, STAGING_VITE_MAP_TILE_URL,
# STAGING_VITE_MAP_ATTRIBUTION, STAGING_VITE_SENTRY_DSN; docs/SERVER_SETUP.md). Quyidagilar serverda yig'iladigan (build) holat uchun.
VITE_BOT_USERNAME=rizqim_staging_bot
# Nisbiy: Mini App app.stg.rizqim.uz da ochiladi va /api/ ni o'z nginx'i backend'ga uzatadi (same-origin, CORS kerak emas)
VITE_API_URL=/api/v1
# Xodim ekranlaridagi "Web panelda tahrirlash" havolasi: staging hamkor paneli (bo'sh = havolasiz)
VITE_PARTNER_WEB_URL=https://business.stg.rizqim.uz
VITE_MAP_TILE_URL=
# Attribution xaritada HTML sifatida chiqadi (escape qilinmaydi): faqat ishonchli, o'zingiz yozgan matn
VITE_MAP_ATTRIBUTION=
# Kalit va host bo'sh qoladi: ilova kalitni GET /api/v1/realtime dan oladi, host = Mini App domeni (WebSocket app.stg.rizqim.uz/app/)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# Sentry: alohida staging loyihasi yoki bo'sh (production xatolari bilan aralashmasin)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Zaxira: staging ma'lumotlari muhim emas, 3 kun yetadi. S3 ixtiyoriy (production bucket'iga YOZMANG: boshqa bucket yoki prefix)
BACKUP_HOST_DIR=./backups
BACKUP_TIME=21:30
BACKUP_RETENTION_DAYS=3
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=rizqim/staging
BACKUP_S3_RETENTION_DAYS=
BACKUP_OFFSITE_CMD=
# Uzluksiz zaxira (PITR): staging'da ham sinab ko'ring (production bilan bir xil yo'l). S3 production bucket'iga YOZMANG.
# Shifrlash paroli staging'niki bo'lsin: openssl rand -base64 48. Batafsil: .env.example va docs/OPERATIONS.md
PITR_ENABLED=1
PITR_CIPHER_PASS=
