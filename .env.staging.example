# STAGING uchun ildiz .env namunasi (alohida serverda): cp .env.staging.example .env
# Production namunasi: .env.example. Staging production bilan bir xil stek, faqat docker-compose.staging.yml qo'shiladi.
# docs/DEPLOY.md, 10-bo'lim.

# Shu qator tufayli `docker compose up -d --build` staging fayli bilan ishga tushadi (-f yozish shart emas)
COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml

# Baza: production nomi/paroli bilan bir xil bo'lmasin (boshqa serverda ham bo'lsa, tasodifan ulanib qolmaslik uchun)
DB_DATABASE=rizqim_staging
DB_USERNAME=rizqim_staging
DB_PASSWORD=CHANGE_ME_staging_db_password
REDIS_PASSWORD=

# Real-time (Reverb): staging'ning O'Z kalitlari (productionnikini ishlatmang). Yaratish:
#   REVERB_APP_ID=$(openssl rand -hex 4)  REVERB_APP_KEY=$(openssl rand -hex 16)  REVERB_APP_SECRET=$(openssl rand -hex 32)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Staging Mini App hosti (masalan staging.rizqim.uz); app:check-production * da ogohlantiradi
REVERB_ALLOWED_ORIGINS=staging.example.uz

# Bir xostda production bilan birga ishlatilsa portlar to'qnashmasin (alohida serverda 8000/8080 qoldirsa ham bo'ladi)
BACKEND_PORT=8100
FRONTEND_PORT=8180

# Mini App build argumentlari (staging TEST boti!). O'zgartirgandan keyin: docker compose up -d --build frontend
VITE_BOT_USERNAME=rizqim_staging_bot
VITE_API_URL=/api/v1
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# Sentry: alohida staging loyihasi yoki bo'sh (production xatolari bilan aralashmasin)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Zaxira: staging ma'lumotlari muhim emas, 3 kun yetadi. S3 ixtiyoriy (production bucket'iga YOZMANG: boshqa bucket yoki prefix)
BACKUP_HOST_DIR=./backups
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=3
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=rizqim/staging
BACKUP_S3_RETENTION_DAYS=
BACKUP_OFFSITE_CMD=
