# PRODUCTION uchun backend/.env namunasi (rizqim.uz): cp backend/.env.production.example backend/.env
# Qolgan o'zgaruvchilarning ma'nosi backend/.env.example da. Staging namunasi: backend/.env.staging.example.
# Production'da docker-compose.staging.yml ISHLATILMAYDI: APP_ENV, APP_DEBUG, TELEGRAM_ALLOW_MOCK_AUTH,
# SMS_EXPOSE_CODE_IN_RESPONSE shu fayldan olinadi, app:check-production ularni tekshiradi. docs/DEPLOY.md, 2 va 11-bo'limlar.
APP_NAME=RIZQIM
APP_ENV=production
# Bir marta yarating va server tashqarisida (parol menejerida) saqlang: yo'qolsa shifrlangan ma'lumotlar o'qilmaydi.
# echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
# Domenlar (rizqim.uz): har host nomi uchun DNS va ildiz .env dagi EDGE_DOMAIN: docs/SERVER_SETUP.md, docs/DEPLOY.md 11-bo'lim.
# APP_URL = API hosti (Telegram webhook va to'lov webhook'lari shu manzilga keladi; Mini App esa API'ga o'z origin'i app.<domen>/api orqali boradi)
APP_URL=https://api.rizqim.uz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# P2-30: the API's own language (validation messages from lang/uz), whatever APP_LOCALE the panels use
API_LOCALE=uz
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr_json
LOG_DEPRECATIONS_CHANNEL=null
# warning: Click, Payme va Telegram webhook payload'lari info darajasida to'liq logga yoziladi (shaxsiy ma'lumot bo'lishi mumkin)
LOG_LEVEL=warning
TRUST_INCOMING_REQUEST_ID=false

# Baza va Redis qiymatlarini docker-compose.yml o'zi beradi (DB_HOST=postgres va h.k., ildiz .env dan)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rizqimbot
DB_USERNAME=rizqimbot
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Real-time: kalitlar va BROADCAST_CONNECTION ildiz .env dan keladi
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origin'lar (scheme'siz): Mini App, hamkor paneli (doska real-time'i) va API hosti (oshxona ekrani ilovasi API hostini yuboradi)
REVERB_ALLOWED_ORIGINS=app.rizqim.uz,business.rizqim.uz,api.rizqim.uz

# Haqiqiy xat/SMS kerak bo'lsa o'zingizning provayderingiz; SMS: boshqaruv markazi, Tizim → Tizim sozlamalari → Sozlamalar
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@rizqim.uz"
MAIL_FROM_NAME="${APP_NAME}"
SMS_DRIVER=eskiz
SMS_EXPOSE_CODE_IN_RESPONSE=false
# `sms_driver` boshqaruv markazida (Tizim → Tizim sozlamalari) bo'lsa, u bu env'dan ustun
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Sentry: production loyihasi yoki bo'sh
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
# APP_VERSION va APP_COMMIT boshqaruv markazi Monitoring → Holat da ko'rinadi (ixtiyoriy)

HEALTH_SCHEDULER_MAX_AGE=180
HEALTH_QUEUE_BACKLOG_WARN=500
HEALTH_REPORTS_BACKLOG_WARN=50
HEALTH_TOKEN=

# Telegram: HAQIQIY bot (BotFather). Webhook bitta bot uchun bitta manzil: bir tokenni staging'da ishlatmang.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=rizqimbot
# Mini App'ning https:// manzili (app:check-production talab qiladi)
TELEGRAM_WEBAPP_URL=https://app.rizqim.uz
# Ochiq sayt: bot telefon raqamini so'raganda /shartlar va /maxfiylik ga havola beradi (bo'sh = https://rizqim.uz)
SITE_URL=https://rizqim.uz

# P4-32: hamkor veb-panelining manzili (partner/web); balans to'ldirish to'lovidan keyin egasi shu panelning /finance
# sahifasiga qaytadi. Bo'sh bo'lsa APP_URL
PARTNER_WEB_URL=https://business.rizqim.uz

# [P4-11] Boshqaruv markazi (platform/admin) manzili: taklif havolalari shu yerga olib boradi ({ADMIN_APP_URL}/invite/...)
ADMIN_APP_URL=https://admin.rizqim.uz

TELEGRAM_WEBHOOK_SECRET=
# Bo'sh = APP_URL + /api/v1/telegram/webhook (= https://api.rizqim.uz/api/v1/telegram/webhook); deploy uni o'zi o'rnatadi
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALLOW_MOCK_AUTH=false
TELEGRAM_SUPERADMIN_CHAT_ID=

SANCTUM_TOKEN_EXPIRATION=43200
# Panel API'ga api.<domen> ga to'g'ridan-to'g'ri murojaat qiladi (PARTNER_PUBLIC_API_BASE_URL), shuning uchun uning origin'i shart.
# Mini App same-origin (app.<domen>/api -> frontend nginx -> backend), lekin ro'yxat berilganda standart originlar o'chadi: uni ham yozing.
# admin.<domen> kerak emas (brauzer backend'ga murojaat qilmaydi). SANCTUM_STATEFUL_DOMAINS ham kerak emas: API Bearer token bilan
# ishlaydi, cookie-sessiya yo'q (SESSION_DOMAIN=null qoladi: panel cookie'lari host'ga bog'langan __Host- cookie'lar).
CORS_ALLOWED_ORIGINS=https://business.rizqim.uz,https://app.rizqim.uz

# To'lov tizimlari: HAQIQIY merchant kalitlari (yoki boshqaruv markazi: Tizim → To'lov tizimlari). Webhook manzillari merchant
# kabinetida: https://api.rizqim.uz/api/v1/payments/click/webhook va https://api.rizqim.uz/api/v1/payments/payme/webhook
CLICK_SECRET_KEY=
PAYME_SECRET_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# P3-14: Click fiskal chek ma'lumoti uchun (Merchant API foydalanuvchisi)
# CLICK_MERCHANT_USER_ID=
# PAYME_MERCHANT_ID=
# Wave P: Paylov (docs/PAYMENTS_GO_LIVE.md, 11-bo'lim). Webhook: https://api.rizqim.uz/api/v1/payments/paylov/webhook
# PAYLOV_MERCHANT_ID=
# PAYLOV_CONSUMER_KEY=
# PAYLOV_CONSUMER_SECRET=
# PAYLOV_USERNAME=
# PAYLOV_PASSWORD=
# PAYLOV_CALLBACK_LOGIN=
# PAYLOV_CALLBACK_PASSWORD=
# PAYLOV_BASE_URL=https://gw2.paylov.uz

ORDERS_UNPAID_ONLINE_TTL_MINUTES=30
ORDERS_SETTLEMENT_RETRY_MAX_ATTEMPTS=12
ORDERS_REPORTS_QUEUE=reports

GEOCODING_PROVIDER=nominatim
GEOCODING_CACHE_TTL=604800
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
NOMINATIM_MIN_INTERVAL=1

# Pennant feature flaglar bazada (jadval `features`)
PENNANT_STORE=database

# TLS sertifikati muddati tekshiriladigan xost (bo'sh = APP_URL xosti)
MONITORING_TLS_HOST=api.rizqim.uz
# Ogohlantirishlar guruhi (docs/OPERATIONS.md, 21-bo'lim); HEALTHCHECKS_PING_URL ildiz .env da
TELEGRAM_OPS_CHAT_ID=

# Faqat SuperAdminSeeder uchun (ixtiyoriy; birinchi superadmin odatda `rizqim:admin:create` bilan; parol kamida 12 belgi)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
