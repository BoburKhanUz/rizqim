APP_NAME=Laravel
# Xavfsiz standart qiymatlar. Lokal ishlab chiqishda: APP_ENV=local, APP_DEBUG=true
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=order_mini_app
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram bot / Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=
# Majburiy: webhook shu maxfiy kalitsiz barcha so'rovlarni rad etadi; faqat A-Z a-z 0-9 _ - (deploy'da telegram:set-webhook o'rnatadi)
TELEGRAM_WEBHOOK_SECRET=
# Telegram uchun ochiq HTTPS manzil; bo'sh bo'lsa APP_URL + /api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Faqat APP_ENV=local bilan ishlaydi; productionda doim false
TELEGRAM_ALLOW_MOCK_AUTH=false

# SMS kodni API javobida qaytarish (faqat APP_ENV=local bilan ishlaydi)
SMS_EXPOSE_CODE_IN_RESPONSE=false

# API token muddati, daqiqada (43200 = 30 kun)
SANCTUM_TOKEN_EXPIRATION=43200

# Vergul bilan ajratilgan originlar; bo'sh bo'lsa TELEGRAM_WEBAPP_URL va APP_URL originlari ruxsat etiladi
CORS_ALLOWED_ORIGINS=

# To'lov tizimlari maxfiy kalitlari
CLICK_SECRET_KEY=
PAYME_SECRET_KEY=

# To'lanmagan onlayn buyurtmalar shu daqiqadan keyin avtomatik bekor qilinadi (scheduler kerak)
ORDERS_UNPAID_ONLINE_TTL_MINUTES=30

# Faqat SuperAdminSeeder uchun: productionda majburiy, parol kamida 12 belgi (seed'dan keyin olib tashlash mumkin)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
