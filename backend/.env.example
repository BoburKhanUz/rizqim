APP_NAME=Laravel
# Xavfsiz standart qiymatlar. Lokal ishlab chiqishda: APP_ENV=local, APP_DEBUG=true
APP_ENV=production
# Productionda majburiy va hamma jarayonlar (web, queue, scheduler konteynerlari) uchun bitta: bir marta yarating
# (php artisan key:generate --show yoki: echo "base64:$(openssl rand -base64 32)") va shu yerga yozing. Konteyner uni
# o'zi yaratmaydi, bo'sh bo'lsa ishga tushmaydi (app:check-production). Lokal: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Loglar. Lokal: single (storage/logs/laravel.log). Production (Docker): LOG_STACK=stderr_json — har qator bitta JSON
# (message, level_name, context, extra.request_id) stderr'ga, `docker compose logs` va log yig'uvchilar o'qiydi.
# Har so'rovga X-Request-Id beriladi va logga request_id sifatida yoziladi (docs/OPERATIONS.md).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# [P1-14] Mijozning X-Request-Id'si e'tiborga olinmaydi (har so'rovga yangi UUID). true bo'lsa faqat ishonchli proksi
# (Mini App nginx, o'z $request_id'sini qo'yadi) bergan qiymat saqlanadi; barcha trafik shu proksi orqali kelsagina yoqing.
TRUST_INCOMING_REQUEST_ID=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=order_mini_app
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time buyurtma holatlari (Laravel Reverb, WebSocket). reverb = yoqiq; null yoki log = o'chiq (qolgan hammasi
# odatdagidek ishlaydi, Mini App so'rov bilan yangilanadi). Kanallar: routes/channels.php, POST /api/broadcasting/auth.
# Docker: BROADCAST_CONNECTION va REVERB_APP_* ni ildiz .env beradi (docker-compose.yml), REVERB_HOST/PORT/SCHEME ni
# compose o'zi (reverb:8080, http); bu yerdagilar e'tiborga olinmaydi. Docker'siz lokal ishlab chiqishda shu yerda to'ldiring (docs/DEPLOY.md).
# Kalitlar: REVERB_APP_ID=$(openssl rand -hex 4), REVERB_APP_KEY=$(openssl rand -hex 16),
# REVERB_APP_SECRET=$(openssl rand -hex 32). KEY Mini App build'iga ham kiradi (VITE_REVERB_APP_KEY), SECRET hech qachon.
# reverb faqat kalitlar bilan: bo'sh kalitlarda private kanal imzosini istalgan kishi soxtalashtiradi
# (app:check-production rad etadi). Shuning uchun standart null.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Backend Reverb serveriga shu manzil orqali yozadi (brauzerlar emas): lokalda shu kompyuter, ichki HTTP
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Server tinglaydigan manzil (reverb:start); lokalda 127.0.0.1 (Docker'da `reverb` xizmati o'zi 0.0.0.0:8080 da tinglaydi, brauzer Mini App nginx'i orqali ulanadi)
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# WebSocket ochishga ruxsat etilgan sahifa hostlari, vergul bilan (masalan mini.example.uz); * = hammasi (productionda
# app:check-production ogohlantiradi)
REVERB_ALLOWED_ORIGINS=*
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis: production standarti. Kesh, navbat (queue), sessiya va rate-limit (throttle) shu yerda saqlanadi (yuqoridagi
# CACHE_STORE, QUEUE_CONNECTION, SESSION_DRIVER). 'database' drayveri zaxira variant bo'lib qoladi: Redis'siz ishlash
# uchun uchalasini ham database qiling (cache, jobs, sessions jadvallari migratsiyalarda bor).
# Database-navbatdan Redis'ga o'tishdan oldin eski navbatni bo'shating: php artisan queue:work database --stop-when-empty
# Docker: REDIS_HOST/REDIS_PORT/REDIS_PASSWORD ni docker-compose.yml o'zi beradi (redis xizmati, parol ildiz .env da).
# Lokal (Docker'siz): redis-server shu kompyuterda, 127.0.0.1 da; PHP kengaytmasi phpredis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Navbat va sessiya REDIS_DB da, kesh REDIS_CACHE_DB da. Ular har xil bo'lishi shart: `cache:clear` (deploy'dagi
# optimize:clear) kesh bazasini butunlay tozalaydi. REDIS_URL ni o'rnatmang: u ikkala bazani bittaga birlashtiradi.
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sentry (xatolar monitoringi). SENTRY_LARAVEL_DSN bo'sh bo'lsa hech narsa yuborilmaydi va ilova odatdagidek ishlaydi.
# Telefon, OTP, initData, Authorization, to'lov kalitlari va karta raqamlari yuborishdan oldin tozalanadi.
SENTRY_LARAVEL_DSN=
# Deploy versiyasi (masalan: git rev-parse --short HEAD); bo'sh bo'lsa Sentry release ko'rsatmaydi
SENTRY_RELEASE=
# Bo'sh bo'lsa APP_ENV ishlatiladi
SENTRY_ENVIRONMENT=
# Performance trace'lar ulushi (0.05 = 5%; 0 = o'chiq). Xatolar uchun SENTRY_SAMPLE_RATE (1.0 = hammasi)
SENTRY_TRACES_SAMPLE_RATE=0.05

# GET /health: scheduler yurak urishi shu soniyadan eski bo'lsa "degraded"; navbat shu sondan oshsa ham
HEALTH_SCHEDULER_MAX_AGE=180
HEALTH_QUEUE_BACKLOG_WARN=500
HEALTH_REPORTS_BACKLOG_WARN=50
# [P1-14] /health ichki raqamlarni (navbat uzunligi, yurak urishi yoshi) ommaga ko'rsatmaydi: faqat ichki tarmoqqa yoki
# `X-Health-Token: <shu qiymat>` yuborgan monitoringga. Bo'sh = token o'chiq (tashqi monitoring faqat ok/degraded/fail ko'radi).
HEALTH_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram bot / Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Mini App'ning https:// manzili: bot tugmalari shuni ochadi (bo'sh bo'lsa tugmalar yuborilmaydi); productionda majburiy
TELEGRAM_WEBAPP_URL=
# Majburiy: webhook shu maxfiy kalitsiz barcha so'rovlarni rad etadi; faqat A-Z a-z 0-9 _ - (deploy'da telegram:set-webhook o'rnatadi)
TELEGRAM_WEBHOOK_SECRET=
# Telegram uchun ochiq HTTPS manzil; bo'sh bo'lsa APP_URL + /api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Faqat APP_ENV=local bilan ishlaydi; productionda doim false
TELEGRAM_ALLOW_MOCK_AUTH=false
# Moliyaviy xatolar (settlement) haqida ogohlantirish yuboriladigan superadmin chat ID'si (ixtiyoriy)
TELEGRAM_SUPERADMIN_CHAT_ID=

# SMS kodni API javobida qaytarish (faqat APP_ENV=local bilan ishlaydi)
SMS_EXPOSE_CODE_IN_RESPONSE=false

# API token muddati, daqiqada (43200 = 30 kun)
SANCTUM_TOKEN_EXPIRATION=43200

# [P1-12] Qurilmaga bog'langan sessiyalar, terminallar va xodim PIN kodi (docs/AUTH.md).
# Mini App tokenlari yuqoridagi SANCTUM_TOKEN_EXPIRATION bo'yicha yashaydi; quyidagilar faqat mobil ilovalar va POS uchun.
# Ilova qurilma bilan kirganda beriladigan access token muddati, daqiqada (refresh token bilan yangilanadi)
AUTH_ACCESS_TOKEN_TTL=15
# Refresh token muddati, kunda (ishlatilmasa shu muddatdan keyin qaytadan kirish kerak)
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Ulangan POS/KDS terminal tokeni muddati, kunda (0 = egasi o'chirmaguncha amal qiladi)
AUTH_DEVICE_TOKEN_TTL_DAYS=365
# Terminalda PIN bilan ochilgan xodim sessiyasi muddati, daqiqada (720 = 12 soat, bitta smena)
AUTH_STAFF_SESSION_TTL=720
# Terminal ulash kodi necha daqiqa amal qiladi
AUTH_PAIRING_CODE_TTL=10
# Bitta terminalda bitta xodim uchun nechta noto'g'ri PIN'dan keyin bloklanadi
AUTH_PIN_MAX_ATTEMPTS=5
# Birinchi bloklash necha soniya; keyingi har bir xatoda ikki baravar oshadi (eng ko'pi 1 soat)
AUTH_PIN_LOCKOUT_SECONDS=60

# Vergul bilan ajratilgan originlar; bo'sh bo'lsa TELEGRAM_WEBAPP_URL va APP_URL originlari ruxsat etiladi
CORS_ALLOWED_ORIGINS=

# To'lov tizimlari maxfiy kalitlari
CLICK_SECRET_KEY=
PAYME_SECRET_KEY=

# To'lanmagan onlayn buyurtmalar shu daqiqadan keyin avtomatik bekor qilinadi (scheduler kerak)
ORDERS_UNPAID_ONLINE_TTL_MINUTES=30
# Muvaffaqiyatsiz settlement'ni qayta urinishlar soni (birinchi xato ham hisoblanadi)
ORDERS_SETTLEMENT_RETRY_MAX_ATTEMPTS=12
# Hisobot eksporti navbati; shu navbatni tinglaydigan alohida worker kerak
ORDERS_REPORTS_QUEUE=reports

# Manzil qidirish va teskari geokodlash (/api/v1/geocode/*). Hozircha faqat "nominatim"
GEOCODING_PROVIDER=nominatim
# Javob keshda turadigan vaqt, soniyada (kamida 1 kun; standart 604800 = 1 hafta)
GEOCODING_CACHE_TTL=604800
# Ochiq nominatim.openstreetmap.org faqat ishlab chiqish va kam trafik uchun; productionda o'z Nominatim serveringiz
# yoki shartnomali provayder manzilini bering
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# User-Agent'dagi aloqa e-pochtasi (ochiq server siyosati talab qiladi); bo'sh bo'lsa APP_URL ishlatiladi
NOMINATIM_EMAIL=
# Butun platforma bo'yicha so'rovlar orasidagi pauza, soniyada (ochiq server: 1 so'rov/s). 0 faqat o'z serveringiz uchun
NOMINATIM_MIN_INTERVAL=1

# SMS: Superadmin > Tizim Sozlamalari dagi qiymatlar ustun, bular faqat u yerda qiymat bo'lmasa ishlatiladi
SMS_DRIVER=log
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Faqat SuperAdminSeeder uchun: productionda majburiy, parol kamida 12 belgi (seed'dan keyin olib tashlash mumkin)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# API hujjatlari (/docs/api, /docs/api.json; P1-11). local va testing muhitida ochiq; boshqa muhitda faqat admin
# panelga kirgan superadmin ko'radi. true: hammaga ochiq (masalan, staging uchun). Productionda false qoldiring
API_DOCS_PUBLIC=false
