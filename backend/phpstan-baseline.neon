parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$amount of method Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\User\>\:\:decrement\(\) expects float\|int, string given\.$#'
			identifier: argument.type
			count: 1
			path: 'app/Actions/Order/CreateOrderAction.php'

		-
			message: '#^While loop condition is always true\.$#'
			identifier: while.alwaysTrue
			count: 1
			path: 'app/Console/Commands/TelegramPollCommand.php'

		-
			message: '#^Parameter \#1 \$seconds of method Illuminate\\Contracts\\Cache\\Lock\:\:block\(\) expects int, float given\.$#'
			identifier: argument.type
			count: 1
			path: 'app/Services/Geo/NominatimGeocoder.php'

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: 'app/Services/Notifications/NotificationFeedService.php'

		-
			message: '#^Using nullsafe method call on non\-nullable type Illuminate\\Console\\Command\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 3
			path: 'database/seeders/SuperAdminSeeder.php'
