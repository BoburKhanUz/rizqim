{
  "version": 1,
  "about": "Wave M5 S2 (docs/scale/M5_DESIGN.md section 3): the discount of a POS order as the server computes it (PosChargesCalculator::discountOf, PosOrderService::cashierMayDiscount). The backend test tests/Feature/PosSync/OfflineDiscountVectorsTest.php and the till's Dart test read this one file, so both sides agree to the tiyin. Money is a decimal string with two decimals.",
  "rules": {
    "percent": "discount = items x value / 100, computed exactly, rounded once to whole so'm, half-up; then at most the items",
    "amount": "discount = value rounded to whole so'm, half-up; then at most the items (to the tiyin)",
    "items": "the sum of the order's lines that are not void; packaging, the service charge, the room fee and the place fee are never discounted",
    "after_discount": "items - discount: what the service charge and the minimum-spend top-up are computed on",
    "cashier_limit": "a cashier (pos.take_payment without orders.discount) may give: percent -> value <= limit; amount -> value x 100 <= items x limit, exactly (the value as typed, before rounding). No limit (null) or 0: none. Holding orders.discount: any discount",
    "recompute": "kind and value are kept on the order; the amount is computed again from the items after every line change"
  },
  "operation": {
    "type": "order.discount",
    "payload": {
      "order": "<order uuid: the till's or the server's>",
      "kind": "percent",
      "value": "10",
      "reason": "Doimiy mijoz",
      "expected_discount": "4100.00"
    },
    "remove": {
      "order": "<order uuid>",
      "kind": "percent",
      "value": "0",
      "expected_discount": "0.00"
    }
  },
  "amounts": [
