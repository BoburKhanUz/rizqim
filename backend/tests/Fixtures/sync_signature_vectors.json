{
  "version": 1,
  "about": "Wave M5 S3 (docs/scale/M5_DESIGN.md 4): the signature of a queued offline operation. Read by the PHP test (backend/tests/Unit/PosSync/SyncSignatureVectorsTest.php) and by the Dart test of pos_sync. Generated once by an independent script (Python hmac/hashlib), never by the code under test.",
  "scheme": {
    "key": "32 bytes per device; on the wire (pairing answer, POST /terminal/sync-key) standard base64 with padding",
    "first_prev": "HMAC-SHA256(key, utf8(label + lowercase(device uuid))), label = 'rizqim-sync/v1/'",
    "mac": "HMAC-SHA256(key, prev (its 32 bytes, not its hex text) || utf8(raw)); raw is the operation's JSON text exactly as written to the journal and sent as `signed`",
    "encoding": "mac and prev travel as 64 lowercase hex characters; kid is an integer",
    "chain": "prev of an operation is the mac of the one before it under the same key; the first operation under a key uses first_prev of that key"
  },
  "label": "rizqim-sync/v1/",
  "test_keys": {
    "about": "No key is written here. key(kid) = HMAC-SHA256(key = utf8(seed), data = utf8('kid-' + kid)), 32 bytes; a test derives them.",
