# STAGING uchun backend/.env namunasi (alohida serverda): cp backend/.env.staging.example backend/.env
# Qolgan o'zgaruvchilarning ma'nosi backend/.env.example da. APP_ENV, APP_DEBUG, TELEGRAM_ALLOW_MOCK_AUTH,
# SMS_EXPOSE_CODE_IN_RESPONSE, MAIL_MAILER va SMS_DRIVER qiymatlarini docker-compose.staging.yml o'zi majburlaydi
# (shu faylda noto'g'ri bo'lsa ham). docs/DEPLOY.md, 10-bo'lim.
APP_NAME="Rizqim Staging"
APP_ENV=staging
# Staging uchun alohida kalit (productionnikini nusxalamang): echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.example.uz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr_json
LOG_DEPRECATIONS_CHANNEL=null
# Staging'da info: xatolarni production'dan oldin ushlash uchun batafsilroq
LOG_LEVEL=info
TRUST_INCOMING_REQUEST_ID=false

# Baza va Redis qiymatlarini docker-compose.yml o'zi beradi (DB_HOST=postgres va h.k., ildiz .env dan)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rizqim_staging
DB_USERNAME=rizqim_staging
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Real-time: kalitlar va BROADCAST_CONNECTION ildiz .env dan keladi
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=staging.example.uz

# Xabarlar faqat logga (compose ham majburlaydi); staging'dan haqiqiy odamga hech narsa ketmasin
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@example.uz"
MAIL_FROM_NAME="${APP_NAME}"
SMS_DRIVER=log
SMS_EXPOSE_CODE_IN_RESPONSE=false
# DIQQAT: Superadmin > Tizim Sozlamalari dagi `sms_driver` bu env'dan ustun. Production bazasini staging'ga tiklasangiz,
# u yerdagi `eskiz` qiymatini `log` ga qaytaring (aks holda haqiqiy mijozlarga SMS ketadi)

# Sentry: alohida staging loyihasi yoki bo'sh
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.05

HEALTH_SCHEDULER_MAX_AGE=180
HEALTH_QUEUE_BACKLOG_WARN=500
HEALTH_REPORTS_BACKLOG_WARN=50
HEALTH_TOKEN=

# Telegram: staging uchun ALOHIDA TEST BOT (BotFather > /newbot). Production bot tokenini bu yerga qo'ymang:
# webhook bitta bot uchun bitta manzil, staging uni productiondan tortib olardi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=rizqim_staging_bot
# Staging Mini App'ning https:// manzili (app:check-production talab qiladi)
TELEGRAM_WEBAPP_URL=https://staging.example.uz
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALLOW_MOCK_AUTH=false
TELEGRAM_SUPERADMIN_CHAT_ID=

SANCTUM_TOKEN_EXPIRATION=43200
# Hamkor veb-panel (partner-web) origin'i (brauzer API'ga shu origin'dan murojaat qiladi) va staging Mini App
CORS_ALLOWED_ORIGINS=https://panel.staging.example.uz,https://staging.example.uz

# To'lov tizimlari: faqat TEST (sandbox) merchant ma'lumotlari. Production kalitlari staging'da bo'lmasin.
# Click: test service_id/merchant_id va maxfiy kalit; Payme: test kassa (test.paycom.uz) kaliti.
CLICK_SECRET_KEY=
PAYME_SECRET_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# PAYME_MERCHANT_ID=

ORDERS_UNPAID_ONLINE_TTL_MINUTES=30
ORDERS_SETTLEMENT_RETRY_MAX_ATTEMPTS=12
ORDERS_REPORTS_QUEUE=reports

GEOCODING_PROVIDER=nominatim
GEOCODING_CACHE_TTL=604800
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
NOMINATIM_MIN_INTERVAL=1

# Pennant feature flaglar bazada (jadval `features`); staging'da yangi imkoniyatlarni avval shu yerda yoqib sinang
PENNANT_STORE=database

# SuperAdminSeeder uchun (parol kamida 12 belgi, productionnikidan farqli)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
