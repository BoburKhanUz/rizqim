# STAGING uchun backend/.env namunasi (alohida serverda): cp backend/.env.staging.example backend/.env
# Qolgan o'zgaruvchilarning ma'nosi backend/.env.example da. APP_ENV, APP_DEBUG, TELEGRAM_ALLOW_MOCK_AUTH,
# SMS_EXPOSE_CODE_IN_RESPONSE, MAIL_MAILER va SMS_DRIVER qiymatlarini docker-compose.staging.yml o'zi majburlaydi
# (shu faylda noto'g'ri bo'lsa ham). docs/DEPLOY.md, 10-bo'lim.
APP_NAME="Rizqim Staging"
APP_ENV=staging
# Staging uchun alohida kalit (productionnikini nusxalamang): echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
# Domenlar (stg.rizqim.uz): har host nomi uchun DNS va ildiz .env dagi EDGE_DOMAIN: docs/SERVER_SETUP.md, docs/DEPLOY.md 11-bo'lim.
# APP_URL = API hosti (Telegram webhook va to'lov webhook'lari shu manzilga keladi; Mini App esa API'ga o'z origin'i app.<domen>/api orqali boradi)
APP_URL=https://api.stg.rizqim.uz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# P2-30: the API's own language (validation messages from lang/uz), whatever APP_LOCALE the panels use
API_LOCALE=uz
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr_json
LOG_DEPRECATIONS_CHANNEL=null
# Staging'da info: xatolarni production'dan oldin ushlash uchun batafsilroq
LOG_LEVEL=info
TRUST_INCOMING_REQUEST_ID=false

# Baza va Redis qiymatlarini docker-compose.yml o'zi beradi (DB_HOST=postgres va h.k., ildiz .env dan)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rizqim_staging
DB_USERNAME=rizqim_staging
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Real-time: kalitlar va BROADCAST_CONNECTION ildiz .env dan keladi
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origin'lar (scheme'siz): Mini App, hamkor paneli (doska real-time'i) va API hosti (oshxona ekrani ilovasi API hostini yuboradi)
REVERB_ALLOWED_ORIGINS=app.stg.rizqim.uz,business.stg.rizqim.uz,api.stg.rizqim.uz

# Xabarlar faqat logga (compose ham majburlaydi); staging'dan haqiqiy odamga hech narsa ketmasin
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@stg.rizqim.uz"
MAIL_FROM_NAME="${APP_NAME}"
SMS_DRIVER=log
SMS_EXPOSE_CODE_IN_RESPONSE=false
# DIQQAT: boshqaruv markazidagi (Tizim → Tizim sozlamalari) `sms_driver` bu env'dan ustun. Production bazasini staging'ga tiklasangiz,
# u yerdagi `eskiz` qiymatini `log` ga qaytaring (aks holda haqiqiy mijozlarga SMS ketadi)

# Sentry: alohida staging loyihasi yoki bo'sh
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.05

HEALTH_SCHEDULER_MAX_AGE=180
HEALTH_QUEUE_BACKLOG_WARN=500
HEALTH_REPORTS_BACKLOG_WARN=50
HEALTH_TOKEN=

# Telegram: staging uchun ALOHIDA TEST BOT (BotFather > /newbot). Production bot tokenini bu yerga qo'ymang:
# webhook bitta bot uchun bitta manzil, staging uni productiondan tortib olardi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=rizqim_staging_bot
# Staging Mini App'ning https:// manzili (app:check-production talab qiladi)
TELEGRAM_WEBAPP_URL=https://app.stg.rizqim.uz

# P4-32: hamkor veb-panelining manzili (partner/web); balans to'ldirish to'lovidan keyin egasi shu panelning /finance
# sahifasiga qaytadi. Bo'sh bo'lsa APP_URL
PARTNER_WEB_URL=https://business.stg.rizqim.uz

# [P4-11] Boshqaruv markazi (platform/admin) manzili: taklif havolalari shu yerga olib boradi ({ADMIN_APP_URL}/invite/...)
ADMIN_APP_URL=https://admin.stg.rizqim.uz

TELEGRAM_WEBHOOK_SECRET=
# Bo'sh = APP_URL + /api/v1/telegram/webhook (= https://api.stg.rizqim.uz/api/v1/telegram/webhook); deploy uni o'zi o'rnatadi
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALLOW_MOCK_AUTH=false
TELEGRAM_SUPERADMIN_CHAT_ID=

SANCTUM_TOKEN_EXPIRATION=43200
# Hamkor veb-panel (partner-web) origin'i (brauzer API'ga shu origin'dan murojaat qiladi) va staging Mini App
# Panel API'ga api.<domen> ga to'g'ridan-to'g'ri murojaat qiladi (PARTNER_PUBLIC_API_BASE_URL), shuning uchun uning origin'i shart.
# Mini App same-origin (app.<domen>/api -> frontend nginx -> backend), lekin ro'yxat berilganda standart originlar o'chadi: uni ham yozing.
# admin.<domen> kerak emas (brauzer backend'ga murojaat qilmaydi). SANCTUM_STATEFUL_DOMAINS ham kerak emas: API Bearer token bilan
# ishlaydi, cookie-sessiya yo'q (SESSION_DOMAIN=null qoladi: panel cookie'lari host'ga bog'langan __Host- cookie'lar).
CORS_ALLOWED_ORIGINS=https://business.stg.rizqim.uz,https://app.stg.rizqim.uz

# To'lov tizimlari: faqat TEST (sandbox) merchant ma'lumotlari. Production kalitlari staging'da bo'lmasin.
# Click: test service_id/merchant_id va maxfiy kalit; Payme: test kassa (test.paycom.uz) kaliti.
CLICK_SECRET_KEY=
PAYME_SECRET_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# P3-14: Click fiskal chek ma'lumoti uchun (Merchant API foydalanuvchisi)
# CLICK_MERCHANT_USER_ID=
# PAYME_MERCHANT_ID=

ORDERS_UNPAID_ONLINE_TTL_MINUTES=30
ORDERS_SETTLEMENT_RETRY_MAX_ATTEMPTS=12
ORDERS_REPORTS_QUEUE=reports

GEOCODING_PROVIDER=nominatim
GEOCODING_CACHE_TTL=604800
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
NOMINATIM_MIN_INTERVAL=1

# Pennant feature flaglar bazada (jadval `features`); staging'da yangi imkoniyatlarni avval shu yerda yoqib sinang
PENNANT_STORE=database

# Faqat SuperAdminSeeder uchun (ixtiyoriy; birinchi superadmin odatda `rizqim:admin:create` bilan; parol kamida 12 belgi,
# productionnikidan farqli)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
